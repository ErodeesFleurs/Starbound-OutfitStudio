[Unit]
Description=Starbound Outfit Studio static HTTPS site
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=outfit-studio
Group=outfit-studio
Environment=XDG_DATA_HOME=/var/lib/outfit-studio
Environment=XDG_CONFIG_HOME=/var/lib/outfit-studio/config
ExecStart=/nix/var/nix/profiles/outfit-caddy/bin/caddy run --config /etc/outfit-studio/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StateDirectory=outfit-studio
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
